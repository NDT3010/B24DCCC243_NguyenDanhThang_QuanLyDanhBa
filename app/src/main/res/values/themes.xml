<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.QuanLyDanhBa" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorPrimaryVariant">@color/teal_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Dùng cho màn hình đăng nhập (không có thanh tiêu đề) -->
    <style name="Theme.QuanLyDanhBa.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Nút bo tròn -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="strokeColor">@color/teal_700</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.App.Button.Danger">
        <item name="backgroundTint">@color/red_600</item>
    </style>

    <!-- Base App style -->
    <style name="App" />

    <!-- Ô nhập liệu -->
    <style name="App.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">#9AA0A6</item>
    </style>

    <!-- Nhãn phía trên ô nhập -->
    <style name="App.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

</resources>
